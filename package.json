{
  "name": "floppy-explorer",
  "version": "0.4.1",
  "description": "EDSK floppy disk image explorer with Greaseweazle integration",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "neu run",
    "build": "neu build --release",
    "build:backend:release": "sh ./scripts/build-backend-release.sh",
    "cli": "node edsk.js"
  },
  "keywords": [
    "edsk",
    "floppy",
    "greaseweazle",
    "disk-image"
  ],
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.837.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "server.js",
      "lib/**/*.js"
    ],
    "assets": [
      "ui/**/*",
      "package.json"
    ],
    "targets": [
      "macos-arm64",
      "macos-x64",
      "win-x64"
    ]
  }
}
